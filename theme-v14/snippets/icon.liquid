{%- comment -%} Inline SVG icons. Accepts: name, size (px, default 20), class {%- endcomment -%}
{%- liquid
  assign s = size | default: 20
  assign cls = class | default: 'icon'
-%}
<svg class="{{ cls }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  {%- case name -%}
    {%- when 'check' -%}<path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'check-circle' -%}<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="M8.5 12.5 11 15l4.5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'arrow-right' -%}<path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'arrow-down' -%}<path d="M12 5v14m-6-6 6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'search' -%}<circle cx="11" cy="11" r="6.2" stroke="currentColor" stroke-width="1.9"/><path d="m15.6 15.6 4.4 4.4" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
    {%- when 'play' -%}<path d="M8 5.5v13l11-6.5-11-6.5Z" fill="currentColor"/>
    {%- when 'cart' -%}<path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 2-1.6L21 8H6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="10" cy="20" r="1.4" fill="currentColor"/><circle cx="17" cy="20" r="1.4" fill="currentColor"/>
    {%- when 'menu' -%}<path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    {%- when 'close' -%}<path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    {%- when 'minus' -%}<path d="M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    {%- when 'plus' -%}<path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    {%- when 'star' -%}<path d="m12 3.6 2.6 5.3 5.9.9-4.2 4.1 1 5.8-5.3-2.8-5.3 2.8 1-5.8L3.5 9.8l5.9-.9L12 3.6Z" fill="currentColor"/>
    {%- when 'shield' -%}<path d="M12 3.2 5 6v6c0 4.2 2.9 7.6 7 8.8 4.1-1.2 7-4.6 7-8.8V6l-7-2.8Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m9 12 2.2 2.2L15.5 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'clock' -%}<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="M12 7.5V12l3 2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    {%- when 'spark' -%}<path d="M12 3v4m0 10v4M3 12h4m10 0h4M6.3 6.3l2.9 2.9m5.6 5.6 2.9 2.9m0-11.4-2.9 2.9m-5.6 5.6-2.9 2.9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    {%- when 'whatsapp' -%}<path d="M20.5 11.6a8.4 8.4 0 0 1-12.4 7.4L3.5 20.5l1.6-4.5a8.4 8.4 0 1 1 15.4-4.4Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M9 9.2c.2-.5.4-.5.7-.5h.5c.2 0 .4 0 .5.4l.6 1.4c.1.2 0 .4-.1.6l-.4.5c-.1.2-.2.3 0 .6a6 6 0 0 0 2.6 2.3c.3.1.4 0 .6-.1l.5-.6c.2-.2.3-.2.6-.1l1.4.7c.2.1.4.3.4.5v.6c0 .6-.5 1.1-1.1 1.2-2.3.4-6-2-7-4.9-.4-1-.5-2 .1-2.6Z" fill="currentColor"/>
    {%- when 'instagram' -%}<rect x="3.5" y="3.5" width="17" height="17" rx="5" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="3.8" stroke="currentColor" stroke-width="1.8"/><circle cx="17" cy="7" r="1.1" fill="currentColor"/>
    {%- when 'youtube' -%}<rect x="2.5" y="5.5" width="19" height="13" rx="4" stroke="currentColor" stroke-width="1.8"/><path d="M10.5 9.5v5l4.5-2.5-4.5-2.5Z" fill="currentColor"/>
    {%- when 'linkedin' -%}<rect x="3.5" y="3.5" width="17" height="17" rx="3" stroke="currentColor" stroke-width="1.8"/><path d="M8 10.5V16M8 8.1v.1M12 16v-3.2c0-1 .7-1.8 1.7-1.8s1.8.8 1.8 1.8V16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    {%- when 'mail' -%}<rect x="3" y="5.5" width="18" height="13" rx="3" stroke="currentColor" stroke-width="1.8"/><path d="m4.5 8 6.4 4.6a2 2 0 0 0 2.2 0L19.5 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    {%- when 'info' -%}<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="M12 11v5.5M12 7.8v.1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    {%- when 'chevron-down' -%}<path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'chevron-right' -%}<path d="m9 6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'quote' -%}<path d="M9.5 6C6.9 7.3 5.5 9.4 5.5 12.2c0 2.3 1.3 3.8 3.2 3.8 1.7 0 2.9-1.2 2.9-2.8 0-1.5-1-2.6-2.5-2.6-.3 0-.6 0-.8.1.3-1.2 1.2-2.3 2.7-3.2L9.5 6Zm8 0c-2.6 1.3-4 3.4-4 6.2 0 2.3 1.3 3.8 3.2 3.8 1.7 0 2.9-1.2 2.9-2.8 0-1.5-1-2.6-2.5-2.6-.3 0-.6 0-.8.1.3-1.2 1.2-2.3 2.7-3.2L17.5 6Z" fill="currentColor"/>
    {%- when 'rupee' -%}<path d="M7 5h10M7 9h10M15.5 5c0 3-2.4 4-5 4h-3l7 10" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'users' -%}<circle cx="9.5" cy="8.5" r="3.5" stroke="currentColor" stroke-width="1.8"/><path d="M3.5 20c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M16 5.2a3.5 3.5 0 0 1 0 6.6M17.5 14.9c2 .7 3.5 2.4 3.5 5.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    {%- when 'truck' -%}<path d="M2.5 6.5h10v9h-10zM12.5 10h4l3 3v2.5h-7z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><circle cx="6" cy="17.5" r="1.6" stroke="currentColor" stroke-width="1.7"/><circle cx="16.5" cy="17.5" r="1.6" stroke="currentColor" stroke-width="1.7"/>
    {%- when 'refresh' -%}<path d="M20 11.5a8 8 0 1 0-2.6 6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/><path d="M20 5.5v6h-6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>
    {%- else -%}<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/>
  {%- endcase -%}
</svg>
