<section class="section contact">
  <div class="page-width contact__grid">
    <div class="contact__intro">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="h2">{{ section.settings.heading }}</h1>
      <div class="rte muted">{{ section.settings.text }}</div>
      <ul class="contact__channels" role="list">
        {%- if settings.whatsapp_number != blank -%}
          <li>
            <a class="contact__channel" href="https://wa.me/{{ settings.whatsapp_number }}?text={{ settings.whatsapp_message | url_encode }}" target="_blank" rel="noopener">
              <span class="contact__channel-icon">{% render 'icon', name: 'whatsapp', size: 20 %}</span>
              <span><b>WhatsApp</b><span>Fastest reply, usually within an hour</span></span>
            </a>
          </li>
        {%- endif -%}
        {%- if settings.support_email != blank -%}
          <li>
            <a class="contact__channel" href="mailto:{{ settings.support_email }}">
              <span class="contact__channel-icon">{% render 'icon', name: 'mail', size: 20 %}</span>
              <span><b>Email</b><span>{{ settings.support_email }}</span></span>
            </a>
          </li>
        {%- endif -%}
        {%- if shop.address.summary != blank -%}
          <li><span class="contact__channel"><span class="contact__channel-icon">{% render 'icon', name: 'users', size: 20 %}</span><span><b>Studio</b><span>{{ shop.address.summary }}</span></span></span></li>
        {%- endif -%}
      </ul>
      <ul class="contact__legal" role="list">
        {%- assign refund_url = shop.refund_policy.url | default: '' -%}
        {%- assign privacy_url = shop.privacy_policy.url | default: '' -%}
        {%- assign terms_url = shop.terms_of_service.url | default: '' -%}
        {%- if refund_url != '' -%}<li><a href="{{ refund_url }}">{{ shop.refund_policy.title | default: 'Refund policy' }}</a></li>{%- endif -%}
        {%- if privacy_url != '' -%}<li><a href="{{ privacy_url }}">{{ shop.privacy_policy.title | default: 'Privacy policy' }}</a></li>{%- endif -%}
        {%- if terms_url != '' -%}<li><a href="{{ terms_url }}">{{ shop.terms_of_service.title | default: 'Terms of service' }}</a></li>{%- endif -%}
      </ul>
    </div>

    <div class="contact__form-wrap">
      {%- form 'contact', class: 'contact__form', id: 'ContactForm' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-success" role="status">{% render 'icon', name: 'check-circle', size: 18 %}{{ section.settings.success_text }}</p>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="form-error" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="field">
          <label class="field__label" for="ContactName">{{ section.settings.name_label }}</label>
          <input class="field__input" type="text" id="ContactName" name="contact[name]" value="{{ form.name }}" autocomplete="name" required>
        </div>
        <div class="field">
          <label class="field__label" for="ContactEmail">{{ section.settings.email_label }}</label>
          <input class="field__input" type="email" id="ContactEmail" name="contact[email]" value="{{ form.email }}" autocomplete="email" required>
        </div>
        <div class="field">
          <label class="field__label" for="ContactPhone">{{ section.settings.phone_label }}</label>
          <input class="field__input" type="tel" id="ContactPhone" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel" inputmode="tel">
        </div>
        <div class="field">
          <label class="field__label" for="ContactTopic">{{ section.settings.topic_label }}</label>
          <div class="select-wrap">
            <select class="field__input" id="ContactTopic" name="contact[topic]">
              {%- assign topics = section.settings.topics | split: ',' -%}
              {%- for topic in topics -%}
                <option value="{{ topic | strip | escape }}">{{ topic | strip }}</option>
              {%- endfor -%}
            </select>
            {% render 'icon', name: 'chevron-down', size: 16, class: 'icon select-wrap__icon' %}
          </div>
        </div>
        <div class="field">
          <label class="field__label" for="ContactBody">{{ section.settings.message_label }}</label>
          <textarea class="field__input field__input--area" id="ContactBody" name="contact[body]" rows="5" required>{{ form.body }}</textarea>
        </div>
        <button type="submit" class="btn btn--primary btn--lg btn--block">{{ section.settings.button_label }}</button>
        <p class="contact__privacy">We use your details only to reply to this message.{% if privacy_url != '' %} See our <a href="{{ privacy_url }}">privacy policy</a>.{% endif %}</p>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Contact" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Talk to a human before you enrol" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Ask about the course, payments, invoices or refunds. If you are not sure the course fits your goal, tell me what you are trying to build and I will say honestly whether it will help.</p>" },
    { "type": "text", "id": "name_label", "label": "Name label", "default": "Your name" },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "Email" },
    { "type": "text", "id": "phone_label", "label": "Phone label", "default": "Phone or WhatsApp (optional)" },
    { "type": "text", "id": "topic_label", "label": "Topic label", "default": "What is this about?" },
    { "type": "text", "id": "topics", "label": "Topic options (comma separated)", "default": "Course content,Payments or EMI,Refund question,Already enrolled,Partnership or bulk seats" },
    { "type": "text", "id": "message_label", "label": "Message label", "default": "Message" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send message" },
    { "type": "textarea", "id": "success_text", "label": "Success message", "default": "Thanks! Your message is with us. You will get a reply by email, usually the same day." }
  ]
}
{% endschema %}
