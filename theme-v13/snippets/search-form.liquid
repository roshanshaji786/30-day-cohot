{%- comment -%} Accepts: id_suffix, placeholder, autofocus {%- endcomment -%}
{%- assign form_id = 'SearchForm' | append: id_suffix -%}
<form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
  <label class="visually-hidden" for="{{ form_id }}">{{ 'general.search.title' | t }}</label>
  <input type="search" id="{{ form_id }}" name="q" class="search-form__input"
    value="{{ search.terms | escape }}"
    placeholder="{{ placeholder | default: 'general.search.placeholder' | t }}"
    {% if autofocus %}autofocus{% endif %}
    autocomplete="off">
  <input type="hidden" name="options[prefix]" value="last">
  <button type="submit" class="search-form__btn btn btn--primary" aria-label="{{ 'general.search.submit' | t }}">
    {% render 'icon', name: 'search', size: 19 %}
  </button>
</form>
