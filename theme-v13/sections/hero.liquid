{%- liquid
  assign course_product = all_products[settings.course_product_handle]
  assign primary_url = section.settings.cta_link | default: course_product.url | default: '#pricing'
  assign secondary_url = section.settings.secondary_link | default: '#curriculum'
  assign fallback_anchor = '#pricing'
  if template.name == 'product'
    assign fallback_anchor = '#buy'
  endif
  if primary_url == blank
    assign primary_url = fallback_anchor
  endif
  assign seats = course_product.selected_or_first_available_variant.inventory_quantity
  assign show_seats = false
  if settings.show_seats_left and course_product != blank and course_product.selected_or_first_available_variant.inventory_management == 'shopify' and seats > 0 and seats <= 12
    assign show_seats = true
  endif
-%}
<section class="hero{% if section.settings.dark %} hero--dark{% endif %}" {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id }}"{% endif %}>
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="page-width hero__grid">
    <div class="hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{% render 'icon', name: 'spark', size: 14 %}{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="hero__title">
        {{ section.settings.heading }}
        {%- if section.settings.heading_accent != blank %} <span class="hl">{{ section.settings.heading_accent }}</span>{% endif -%}
      </h1>
      {%- if section.settings.subheading != blank -%}
        <div class="hero__sub rte">{{ section.settings.subheading }}</div>
      {%- endif -%}

      {%- if section.settings.show_rating -%}
        <div class="hero__rating">
          {% render 'stars', rating: section.settings.rating, count: section.settings.rating_count %}
          <span class="hero__rating-text">{{ section.settings.rating_text }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.bullet_1 != blank or section.settings.bullet_2 != blank or section.settings.bullet_3 != blank -%}
        <ul class="hero__bullets" role="list">
          {%- for i in (1..3) -%}
            {%- assign key = 'bullet_' | append: i -%}
            {%- if section.settings[key] != blank -%}
              <li>{% render 'icon', name: 'check', size: 16 %}<span>{{ section.settings[key] }}</span></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="hero__cta">
        <a class="btn btn--primary btn--lg" href="{{ primary_url }}" data-cta="hero-primary">
          {%- if section.settings.cta_label != blank -%}{{ section.settings.cta_label }}{%- else -%}{{ 'products.product.add_to_cart' | t }}{%- endif -%}
          {%- if course_product != blank and section.settings.show_price_in_cta %} · {{ course_product.price | money }}{% endif -%}
        </a>
        {%- if section.settings.secondary_label != blank -%}
          <a class="btn btn--ghost btn--lg" href="{{ secondary_url }}">{{ section.settings.secondary_label }}</a>
        {%- endif -%}
      </div>

      <ul class="hero__meta" role="list">
        {%- if course_product != blank and course_product.compare_at_price > course_product.price -%}
          {%- assign saved_amount = course_product.compare_at_price | minus: course_product.price | money -%}
          <li class="hero__meta-item hero__meta-item--save">{% render 'icon', name: 'spark', size: 15 %}{{ 'products.product.on_sale' | t: amount: saved_amount }}</li>
        {%- endif -%}
        {%- if show_seats -%}
          <li class="hero__meta-item">{% render 'icon', name: 'users', size: 15 %}{{ 'products.product.low_stock' | t: count: seats }}</li>
        {%- endif -%}
        {%- if section.settings.meta_1 != blank -%}<li class="hero__meta-item">{% render 'icon', name: 'clock', size: 15 %}{{ section.settings.meta_1 }}</li>{%- endif -%}
        {%- if section.settings.meta_2 != blank -%}<li class="hero__meta-item">{% render 'icon', name: 'shield', size: 15 %}{{ section.settings.meta_2 }}</li>{%- endif -%}
      </ul>
    </div>

    <div class="hero__media">
      {%- if section.settings.image != blank -%}
        {%- if settings.preload_hero_image -%}
          <link rel="preload" as="image" href="{{ section.settings.image | image_url: width: 900 }}" fetchpriority="high">
        {%- endif -%}
        {{ section.settings.image
           | image_url: width: 1200
           | image_tag:
             widths: '420,640,860,1200',
             sizes: '(max-width: 899px) 92vw, 46vw',
             loading: 'eager',
             fetchpriority: 'high',
             class: 'hero__img',
             alt: section.settings.image.alt | default: section.settings.heading }}
      {%- else -%}
        <div class="hero__art" aria-hidden="true">
          <div class="hero__art-card hero__art-card--a">{% render 'icon', name: 'spark', size: 22 %}<b>AI</b><span>Prompt to product</span></div>
          <div class="hero__art-card hero__art-card--b">{% render 'icon', name: 'cart', size: 22 %}<b>Shopify</b><span>Store live in 30 days</span></div>
          <div class="hero__art-ring"></div>
        </div>
      {%- endif -%}

      {%- if section.settings.stat_1_value != blank -%}
        <div class="hero__stat hero__stat--one">
          <b>{{ section.settings.stat_1_value }}</b><span>{{ section.settings.stat_1_label }}</span>
        </div>
      {%- endif -%}
      {%- if section.settings.stat_2_value != blank -%}
        <div class="hero__stat hero__stat--two">
          <b>{{ section.settings.stat_2_value }}</b><span>{{ section.settings.stat_2_label }}</span>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "program" },
    { "type": "checkbox", "id": "dark", "label": "Dark hero", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Founding cohort \u00b7 First 25 students" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Learn AI, build a Shopify store," },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (coloured)", "default": "launch in 30 days." },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Fifteen live evening classes where you use AI to research a niche, build a real Shopify store and get it ready to sell \u2014 with personal feedback from your instructor and a small group of founders.</p>" },
    { "type": "text", "id": "bullet_1", "label": "Bullet 1", "default": "Build your store during the course, not after it" },
    { "type": "text", "id": "bullet_2", "label": "Bullet 2", "default": "No coding, no prior experience needed" },
    { "type": "text", "id": "bullet_3", "label": "Bullet 3", "default": "Recordings + templates you keep forever" },
    { "type": "header", "content": "Rating" },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating row", "default": true },
    { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 0.1, "default": 4.9 },
    { "type": "number", "id": "rating_count", "label": "Number of reviews", "default": 0 },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "Rated by past workshop attendees" },
    { "type": "header", "content": "Calls to action" },
    { "type": "text", "id": "cta_label", "label": "Primary button label", "default": "Enrol now" },
    { "type": "checkbox", "id": "show_price_in_cta", "label": "Show price in the primary button", "default": true },
    { "type": "url", "id": "cta_link", "label": "Primary button link", "info": "Leave empty to link to the course product." },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "See the curriculum" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
    { "type": "header", "content": "Meta row" },
    { "type": "text", "id": "meta_1", "label": "Meta 1", "default": "Starts Oct 1, 2026 \u00b7 9:00 PM IST" },
    { "type": "text", "id": "meta_2", "label": "Meta 2", "default": "15 live classes on Google Meet" },
    { "type": "header", "content": "Media" },
    { "type": "image_picker", "id": "image", "label": "Hero image", "info": "Portrait or square works best. Leave empty to show the built-in graphic." },
    { "type": "text", "id": "stat_1_value", "label": "Floating stat 1 value", "default": "15" },
    { "type": "text", "id": "stat_1_label", "label": "Floating stat 1 label", "default": "live classes" },
    { "type": "text", "id": "stat_2_value", "label": "Floating stat 2 value", "default": "30" },
    { "type": "text", "id": "stat_2_label", "label": "Floating stat 2 label", "default": "days to launch" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
