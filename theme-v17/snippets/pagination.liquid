{%- if paginate.pages > 1 -%}
  <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
    {%- if paginate.previous -%}
      <a class="pagination__item" href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">{% render 'icon', name: 'chevron-right', size: 16, class: 'icon pagination__icon--prev' %}<span>{{ 'general.pagination.previous' | t }}</span></a>
    {%- endif -%}
    <ol class="pagination__list">
      {%- for part in paginate.parts -%}
        <li>
          {%- if part.is_link -%}
            <a class="pagination__item" href="{{ part.url }}">{{ part.title }}</a>
          {%- else -%}
            <span class="pagination__item pagination__item--current" aria-current="page">{{ part.title }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
    {%- if paginate.next -%}
      <a class="pagination__item" href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}"><span>{{ 'general.pagination.next' | t }}</span>{% render 'icon', name: 'chevron-right', size: 16 %}</a>
    {%- endif -%}
  </nav>
{%- endif -%}
