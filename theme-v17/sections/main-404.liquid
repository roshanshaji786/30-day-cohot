<section class="section not-found">
  <div class="page-width page-width--narrow not-found__inner">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="h2">{{ 'general.404.title' | t }}</h1>
    <div class="rte muted"><p>{{ 'general.404.subtext' | t }}</p></div>
    <div class="not-found__actions">
      <a class="btn btn--primary btn--lg" href="{{ routes.root_url }}">{{ 'general.404.cta' | t }}</a>
      <a class="btn btn--ghost btn--lg" href="{{ routes.all_products_collection_url }}">{{ section.settings.catalog_label }}</a>
    </div>
    <div class="not-found__search">{% render 'search-form' %}</div>
  </div>
</section>

{% schema %}
{
  "name": "404",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Error 404" },
    { "type": "text", "id": "catalog_label", "label": "Catalogue button label", "default": "Browse the course" }
  ]
}
{% endschema %}
