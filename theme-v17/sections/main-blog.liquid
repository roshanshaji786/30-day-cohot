<section class="section blog">
  <div class="page-width">
    <header class="section-head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="h2">{{ blog.title }}</h1>
    </header>
    {%- paginate blog.articles by 9 -%}
      {%- if blog.articles.size > 0 -%}
        <ul class="product-grid" role="list">
          {%- for article in blog.articles -%}
            <li class="product-card">
              <a class="product-card__media" href="{{ article.url }}" aria-hidden="true" tabindex="-1">
                {%- if article.image -%}
                  {{ article.image | image_url: width: 900 | image_tag: widths: '300,500,700,900', sizes: '(max-width: 749px) 92vw, 30vw', loading: 'lazy', class: 'product-card__img', alt: article.image.alt | default: article.title }}
                {%- else -%}
                  <span class="product-card__placeholder">{% render 'icon', name: 'quote', size: 28 %}</span>
                {%- endif -%}
              </a>
              <div class="product-card__body">
                <p class="product-card__kicker">{{ article.published_at | date: '%b %d, %Y' }}</p>
                <h2 class="product-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
                <p class="product-card__text">{{ article.excerpt_or_content | strip_html | truncatewords: 20 }}</p>
                <a class="link-arrow" href="{{ article.url }}">{{ 'blogs.article.read_more' | t }}</a>
              </div>
            </li>
          {%- endfor -%}
        </ul>
        {%- render 'pagination', paginate: paginate -%}
      {%- else -%}
        <div class="empty-state"><p class="empty-state__title">{{ 'blogs.blog.empty' | t }}</p></div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Journal" }
  ]
}
{% endschema %}
