<section class="section includes" {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id }}"{% endif %}>
  <div class="page-width">
    <header class="section-head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="rte muted section-head__text">{{ section.settings.text }}</div>{%- endif -%}
    </header>
    <ul class="bento" role="list">
      {%- for block in section.blocks -%}
        <li class="bento__card{% if block.settings.wide %} bento__card--wide{% endif %}{% if block.settings.highlight %} bento__card--highlight{% endif %}" {{ block.shopify_attributes }}>
          <span class="bento__icon">{% render 'icon', name: block.settings.icon, size: 22 %}</span>
          <h3 class="bento__title">{{ block.settings.title }}</h3>
          <p class="bento__text">{{ block.settings.text }}</p>
          {%- if block.settings.value != blank -%}<span class="bento__value">{{ block.settings.value }}</span>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "What's included",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "included" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Everything included" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What you get for the fee" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>No upsells inside the course. Everything below is included from day one.</p>" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Included item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "spark", "label": "Spark" },
          { "value": "play", "label": "Play / video" },
          { "value": "users", "label": "Group" },
          { "value": "shield", "label": "Shield" },
          { "value": "clock", "label": "Clock" },
          { "value": "cart", "label": "Cart" },
          { "value": "check-circle", "label": "Check" },
          { "value": "rupee", "label": "Rupee" },
          { "value": "truck", "label": "Delivery" },
          { "value": "refresh", "label": "Refresh" }
        ], "default": "spark" },
        { "type": "text", "id": "title", "label": "Title", "default": "Included" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "What the student gets." },
        { "type": "text", "id": "value", "label": "Value tag", "info": "Optional. e.g. Worth \u20b91,500" },
        { "type": "checkbox", "id": "wide", "label": "Wide card", "default": false },
        { "type": "checkbox", "id": "highlight", "label": "Highlight card", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "What's included",
      "blocks": [
        { "type": "item", "settings": { "icon": "play", "title": "15 live classes", "text": "Three weeks of guided, screen-share sessions on Google Meet at 9:00 PM IST.", "value": "Worth \u20b922,500" } },
        { "type": "item", "settings": { "icon": "refresh", "title": "Lifetime recordings", "text": "Every class recorded and posted within 24 hours. Rewatch forever." } },
        { "type": "item", "settings": { "icon": "spark", "title": "AI prompt library", "text": "The exact prompts I use for niche research, copy, product pages and ads.", "highlight": true } },
        { "type": "item", "settings": { "icon": "users", "title": "Personal feedback", "text": "Small cohort, so your store gets reviewed live instead of just watching demos." } },
        { "type": "item", "settings": { "icon": "check-circle", "title": "Launch checklist", "text": "A step-by-step pre-launch and first-orders checklist you can tick off." } },
        { "type": "item", "settings": { "icon": "shield", "title": "Community access", "text": "Private group for questions, wins and accountability after the course ends." } }
      ]
    }
  ]
}
{% endschema %}
