<section class="section page-content">
  <div class="page-width page-width--narrow">
    {%- if section.settings.show_breadcrumbs -%}{% render 'breadcrumbs' %}{%- endif -%}
    <h1 class="h2 page-content__title">{{ page.title }}</h1>
    <div class="rte">{{ page.content }}</div>
    {%- if section.settings.show_contact_cta -%}
      <div class="page-content__cta">
        <p>{{ section.settings.cta_text }}</p>
        {%- assign cta_class = 'btn btn--primary btn--lg' -%}
        {% render 'contact-link', link: section.settings.contact_link, class: cta_class, label: section.settings.cta_label %}
        {%- if settings.whatsapp_number != blank -%}
          <a class="btn btn--ghost btn--lg" href="https://wa.me/{{ settings.whatsapp_number }}?text={{ settings.whatsapp_message | url_encode }}" target="_blank" rel="noopener">
            {% render 'icon', name: 'whatsapp', size: 18 %}<span>{{ 'general.social.whatsapp' | t }}</span>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Show breadcrumbs", "default": true },
    { "type": "checkbox", "id": "show_contact_cta", "label": "Show contact call to action", "default": true },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Questions about the course, refunds or invoices?" },
    { "type": "text", "id": "cta_label", "label": "CTA button label", "default": "Contact us" },
    { "type": "url", "id": "contact_link", "label": "Contact page", "info": "Optional. Defaults to WhatsApp or your support email." }
  ]
}
{% endschema %}
