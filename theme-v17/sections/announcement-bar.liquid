{%- liquid
  assign deadline = settings.cohort_deadline | default: settings.cohort_start_date
-%}
<div class="announcement" data-announcement>
  <div class="page-width announcement__inner">
    {%- if section.settings.show_countdown and deadline != blank -%}
      <countdown-timer class="countdown" data-deadline="{{ deadline }}" data-finished="{{ section.settings.finished_text | escape }}">
        <span class="countdown__text">{{ section.settings.countdown_label | default: 'Enrolment closes in' }}</span>
        <span class="countdown__clock" aria-hidden="true">
          <span class="countdown__unit"><b data-days>--</b><i>d</i></span>
          <span class="countdown__sep">:</span>
          <span class="countdown__unit"><b data-hours>--</b><i>h</i></span>
          <span class="countdown__sep">:</span>
          <span class="countdown__unit"><b data-minutes>--</b><i>m</i></span>
          <span class="countdown__sep">:</span>
          <span class="countdown__unit"><b data-seconds>--</b><i>s</i></span>
        </span>
        <span class="visually-hidden" data-countdown-live aria-live="polite"></span>
      </countdown-timer>
    {%- endif -%}
    <div class="announcement__text">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}">
      {%- endif -%}
      {% render 'icon', name: 'spark', size: 15 %}
      <span>{{ section.settings.text }}</span>
      {%- if section.settings.link != blank -%}
        {% render 'icon', name: 'arrow-right', size: 15 %} </a>
      {%- endif -%}
    </div>
    {%- if section.settings.show_whatsapp and settings.whatsapp_number != blank -%}
      <a class="announcement__wa" href="https://wa.me/{{ settings.whatsapp_number }}?text={{ settings.whatsapp_message | url_encode }}" target="_blank" rel="noopener">
        {% render 'icon', name: 'whatsapp', size: 15 %}<span class="announcement__wa-text">{{ section.settings.whatsapp_label | default: 'Ask a question' }}</span>
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Live cohort \u00b7 15 classes \u00b7 Small group, personal feedback" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "checkbox", "id": "show_countdown", "label": "Show countdown", "default": true },
    { "type": "text", "id": "countdown_label", "label": "Countdown label", "default": "Enrolment closes in" },
    { "type": "text", "id": "finished_text", "label": "Text after the deadline", "default": "Enrolment for this cohort has closed" },
    { "type": "checkbox", "id": "show_whatsapp", "label": "Show WhatsApp link", "default": true },
    { "type": "text", "id": "whatsapp_label", "label": "WhatsApp label", "default": "Ask a question" }
  ],
  "presets": [{ "name": "Announcement bar" }]
}
{% endschema %}
