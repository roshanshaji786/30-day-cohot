[
  {
    "name": "theme_info",
    "theme_name": "Cohort",
    "theme_version": "17.0.0",
    "theme_author": "Roshan Shaji × DARTS AI Academy",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/manual/online-store/themes"
  },
  {
    "name": "Quick checkout",
    "settings": [
      {
        "type": "paragraph",
        "content": "Express checkout jumps straight to Shopify's one-page checkout, skipping the cart — the same flow Shiprocket Checkout gives you, using Shopify's native checkout (which cannot be restyled without Shopify Plus)."
      },
      {
        "type": "checkbox",
        "id": "express_checkout",
        "label": "Show Buy it now (skip the cart)",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "express_show_price",
        "label": "Show price on the express button",
        "default": true
      },
      {
        "type": "text",
        "id": "express_label",
        "label": "Express button label",
        "default": "Buy it now"
      },
      {
        "type": "text",
        "id": "express_note",
        "label": "Express button note",
        "default": "Straight to secure checkout. Skip the cart — UPI, cards, netbanking and wallets."
      },
      {
        "type": "checkbox",
        "id": "express_in_buybar",
        "label": "Express button in the mobile buy bar",
        "default": true
      },
      {
        "type": "select",
        "id": "fulfilment_kind",
        "label": "How you deliver",
        "options": [
          {
            "value": "auto",
            "label": "Detect automatically"
          },
          {
            "value": "digital",
            "label": "Digital / instant access"
          },
          {
            "value": "physical",
            "label": "Shipped by courier"
          }
        ],
        "default": "auto",
        "info": "Digital products promise instant access; physical ones get a pincode delivery estimate."
      },
      {
        "type": "text",
        "id": "fulfilment_label",
        "label": "Digital delivery label",
        "default": "Instant access after payment"
      },
      {
        "type": "text",
        "id": "fulfilment_hint",
        "label": "Digital delivery hint",
        "default": "Course link, class calendar and recordings land in your inbox within minutes."
      },
      {
        "type": "number",
        "id": "delivery_min_days",
        "label": "Fastest delivery (working days)",
        "default": 3
      },
      {
        "type": "number",
        "id": "delivery_max_days",
        "label": "Slowest delivery (working days)",
        "default": 6
      },
      {
        "type": "text",
        "id": "dispatch_from",
        "label": "Dispatch from",
        "default": "Kerala"
      },
      {
        "type": "checkbox",
        "id": "qcheck_show_coupon",
        "label": "Show discount-code box",
        "default": true
      },
      {
        "type": "text",
        "id": "coupon_label",
        "label": "Coupon label",
        "default": "Have a discount code?"
      },
      {
        "type": "checkbox",
        "id": "qcheck_show_cod",
        "label": "List cash on delivery",
        "default": false
      },
      {
        "type": "text",
        "id": "pay_label",
        "label": "Payment heading",
        "default": "Pay however you like"
      },
      {
        "type": "text",
        "id": "pay_hint",
        "label": "Payment hint",
        "default": "256-bit encrypted. We never see your card details."
      },
      {
        "type": "text",
        "id": "qcheck_badge_1",
        "label": "Assurance 1",
        "default": "7-day full refund if it is not for you"
      },
      {
        "type": "text",
        "id": "qcheck_badge_2",
        "label": "Assurance 2",
        "default": "Certificate and recordings stay yours forever"
      },
      {
        "type": "text",
        "id": "qcheck_badge_3",
        "label": "Assurance 3",
        "default": "GST invoice emailed with your receipt"
      }
    ]
  },
  {
    "name": "Course product",
    "settings": [
      {
        "type": "text",
        "id": "course_product_handle",
        "label": "Course product handle",
        "default": "ai-shopify-business-bootcamp",
        "info": "The handle of the single product this store sells. Every enrol button on the site reads its live price, inventory and availability from this product."
      },
      {
        "type": "checkbox",
        "id": "show_seats_left",
        "label": "Show real seats left",
        "default": true,
        "info": "Reads the product's tracked inventory quantity, so urgency claims always match reality."
      },
      {
        "type": "text",
        "id": "cohort_start_date",
        "label": "Cohort start date",
        "default": "2026-10-01T21:00:00+05:30",
        "info": "ISO 8601 with timezone, e.g. 2026-10-01T21:00:00+05:30. Drives the countdown timer."
      },
      {
        "type": "text",
        "id": "cohort_deadline",
        "label": "Enrolment closes",
        "info": "Optional ISO 8601 date. If blank, the countdown uses the cohort start date."
      }
    ]
  },
  {
    "name": "Logo & icons",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 260,
        "step": 10,
        "default": 130,
        "unit": "px",
        "label": "Logo width"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "32 × 32px .png recommended. Displayed at 32px."
      },
      {
        "type": "text",
        "id": "brand_name",
        "label": "Brand name",
        "default": "ROSHAN SHAJI"
      },
      {
        "type": "text",
        "id": "brand_subbrand",
        "label": "Sub-brand",
        "default": "DARTS AI ACADEMY"
      }
    ]
  },
  {
    "name": "Colours",
    "settings": [
      {
        "type": "header",
        "content": "Light surfaces"
      },
      {
        "type": "color",
        "id": "color_bg",
        "label": "Background",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Soft surface",
        "default": "#f6f5fb"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Text",
        "default": "#12121a"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted text",
        "default": "#55555f",
        "info": "Keep at least 4.5:1 contrast against the background."
      },
      {
        "type": "color",
        "id": "color_line",
        "label": "Borders",
        "default": "#e7e5f0"
      },
      {
        "type": "header",
        "content": "Brand"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "default": "#4f2fd6"
      },
      {
        "type": "color",
        "id": "color_on_accent",
        "label": "Text on accent",
        "default": "#ffffff"
      },
      {
        "type": "header",
        "content": "Dark surfaces"
      },
      {
        "type": "color",
        "id": "color_dark",
        "label": "Dark background",
        "default": "#12121a"
      },
      {
        "type": "color",
        "id": "color_on_dark",
        "label": "Dark text",
        "default": "#f5f4fa"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "assistant_n4",
        "label": "Heading font"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "assistant_n4",
        "label": "Body font"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 90,
        "max": 130,
        "step": 5,
        "default": 100,
        "unit": "%",
        "label": "Heading size scale"
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 95,
        "max": 120,
        "step": 5,
        "default": 100,
        "unit": "%",
        "label": "Body size scale"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1040,
        "max": 1560,
        "step": 20,
        "default": 1200,
        "unit": "px",
        "label": "Page width"
      },
      {
        "type": "range",
        "id": "section_spacing",
        "min": 48,
        "max": 140,
        "step": 4,
        "default": 88,
        "unit": "px",
        "label": "Desktop section spacing"
      },
      {
        "type": "range",
        "id": "corner_radius",
        "min": 0,
        "max": 32,
        "step": 2,
        "default": 18,
        "unit": "px",
        "label": "Corner radius"
      },
      {
        "type": "checkbox",
        "id": "reveal_on_scroll",
        "label": "Reveal sections on scroll",
        "default": true
      }
    ]
  },
  {
    "name": "Contact & social",
    "settings": [
      {
        "type": "text",
        "id": "whatsapp_number",
        "label": "WhatsApp number",
        "info": "Digits with country code, no + or spaces. e.g. 919876543210"
      },
      {
        "type": "text",
        "id": "whatsapp_message",
        "label": "WhatsApp pre-filled message",
        "default": "Hi! I have a question about the AI × Shopify Business Bootcamp."
      },
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube URL"
      },
      {
        "type": "text",
        "id": "social_linkedin",
        "label": "LinkedIn URL"
      },
      {
        "type": "text",
        "id": "support_email",
        "label": "Support email",
        "default": "hello@dartsai.academy"
      }
    ]
  },
  {
    "name": "SEO & sharing",
    "settings": [
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Social share image",
        "info": "1200 × 630px. Used for WhatsApp, iMessage, LinkedIn, X and Facebook previews."
      },
      {
        "type": "text",
        "id": "seo_org_name",
        "label": "Organisation name",
        "default": "DARTS AI Academy"
      },
      {
        "type": "url",
        "id": "seo_same_as",
        "label": "Organisation profile URL",
        "info": "Instagram, LinkedIn or Google Business URL, used in structured data."
      },
      {
        "type": "video",
        "id": "share_video",
        "label": "Social share video",
        "info": "Pick the same clip you use in the walkthrough section. Adds og:video so WhatsApp, Facebook, LinkedIn and Google render a playable card instead of a bare link."
      }
    ]
  },
  {
    "name": "Performance",
    "settings": [
      {
        "type": "checkbox",
        "id": "preload_hero_image",
        "label": "Preload the hero image",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "sticky_buy_bar",
        "label": "Sticky mobile buy bar",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "cart_drawer_enabled",
        "label": "Cart drawer",
        "default": true
      }
    ]
  }
]
