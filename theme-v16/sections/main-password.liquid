<div class="password">
  <div class="password__card">
    {%- if settings.logo != blank -%}
      {{ settings.logo | image_url: width: 300 | image_tag: widths: '150,300', sizes: '150px', loading: 'eager', class: 'password__logo', alt: shop.name }}
    {%- else -%}
      <span class="brand__mark brand__mark--lg" aria-hidden="true">{{ settings.brand_name | slice: 0, 1 }}</span>
    {%- endif -%}
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="h2">{{ section.settings.heading }}</h1>
    <div class="rte muted"><p>{{ section.settings.text }}</p></div>

    {%- if section.settings.show_signup -%}
      {%- form 'customer', class: 'password__form' -%}
        <input type="hidden" name="contact[tags]" value="prospect, password page">
        {%- if form.posted_successfully? -%}
          <p class="form-success" role="status">{% render 'icon', name: 'check-circle', size: 18 %}{{ section.settings.success_text }}</p>
        {%- endif -%}
        <div class="field">
          <label class="field__label" for="PasswordEmail">{{ section.settings.email_label }}</label>
          <input class="field__input" type="email" name="contact[email]" id="PasswordEmail" autocomplete="email" required>
        </div>
        <button type="submit" class="btn btn--primary btn--lg btn--block">{{ section.settings.button_label }}</button>
      {%- endform -%}
    {%- endif -%}

    <ul class="password__points tick-list tick-list--tight" role="list">
      <li>{% render 'icon', name: 'check-circle', size: 17 %}<span>{{ section.settings.point_1 }}</span></li>
      <li>{% render 'icon', name: 'check-circle', size: 17 %}<span>{{ section.settings.point_2 }}</span></li>
    </ul>

    {%- if settings.whatsapp_number != blank -%}
      <a class="link-arrow" href="https://wa.me/{{ settings.whatsapp_number }}?text={{ settings.whatsapp_message | url_encode }}" target="_blank" rel="noopener">{{ 'general.social.whatsapp' | t }}</a>
    {%- endif -%}

    {%- if section.settings.show_password_form -%}
      <details class="password__enter">
        <summary>{{ section.settings.enter_label }}</summary>
        {%- form 'storefront_password' -%}
          {%- if form.errors -%}<div class="form-error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          <div class="field">
            <label class="field__label" for="Password">{{ section.settings.password_label }}</label>
            <input class="field__input" type="password" name="password" id="Password" autocomplete="current-password">
          </div>
          <button type="submit" class="btn btn--ghost btn--block">{{ section.settings.enter_label }}</button>
        {%- endform -%}
      </details>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Opening soon" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The next cohort is almost ready" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Join the list and be first to know when enrolment opens \u2014 founding-cohort seats are limited." },
    { "type": "checkbox", "id": "show_signup", "label": "Show email signup", "default": true },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "Email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Notify me" },
    { "type": "textarea", "id": "success_text", "label": "Success message", "default": "You are on the list!" },
    { "type": "text", "id": "point_1", "label": "Point 1", "default": "15 live classes, small group" },
    { "type": "text", "id": "point_2", "label": "Point 2", "default": "Build and launch a real Shopify store" },
    { "type": "checkbox", "id": "show_password_form", "label": "Show store password form", "default": true },
    { "type": "text", "id": "enter_label", "label": "Enter link label", "default": "Enter using password" },
    { "type": "text", "id": "password_label", "label": "Password field label", "default": "Store password" }
  ]
}
{% endschema %}
